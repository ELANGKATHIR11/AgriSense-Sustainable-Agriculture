{
  "name": "agrisense-backend",
  "version": "1.0.0",
  "description": "AgriSense Sustainable Agriculture Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:backend": "nodemon server.js",
    "dev:frontend": "cd ../frontend && npm run dev",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" --names \"backend,frontend\" --prefix-colors \"blue,green\"",
    "build:frontend": "cd ../frontend && npm run build",
    "start:production": "npm run build:frontend && NODE_ENV=production node server.js",
    "test": "jest --passWithNoTests",
    "build": "echo 'No build step required for Node.js'"
  },
  "dependencies": {
    "pg": "^8.11.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^6.14.3",
    "helmet": "^6.0.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.13.8",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.3.1",
    "nodemon": "^3.1.11",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "agriculture",
    "ml",
    "api",
    "sustainability"
  ],
  "author": "AgriSense Team",
  "license": "MIT"
}
