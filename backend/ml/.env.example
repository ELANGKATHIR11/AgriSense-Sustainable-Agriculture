# AgriSense Python ML Service Environment
# Copy this file to .env and fill in your values.
# Never commit the .env file.

# ─── Service configuration ────────────────────────────────
ML_PORT=8000
ML_HOST=0.0.0.0
ML_WORKERS=1

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3001

# ─── Model paths ──────────────────────────────────────────
MODELS_DIR=./models

# ─── Hardware ─────────────────────────────────────────────
# Set to true if a CUDA-capable GPU is available
USE_GPU=false

# ─── Edge AI (optional) ───────────────────────────────────
# Path to quantized model for offline/edge inference
EDGE_MODEL_PATH=./models/edge

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
