# AgriSense Node.js Backend Environment
# Copy this file to .env and fill in your values.
# Never commit the .env file.

# ─── General ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── CORS / Frontend ──────────────────────────────────────
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# ─── Database (choose one) ────────────────────────────────
# MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/agrisense

# PostgreSQL (set DB_TYPE=postgres to use instead)
DB_TYPE=mongodb
PGHOST=localhost
PGPORT=5432
PGDATABASE=agrisense
PGUSER=agrisense
PGPASSWORD=your-postgres-password-here

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_EXPIRE=7d

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── ML Service ───────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
USE_ML_SERVICE=true

# ─── Edge AI (optional) ───────────────────────────────────
USE_EDGE_AI=false
EDGE_AI_URL=http://localhost:5002

# ─── Redis (optional, for caching/sessions) ───────────────
REDIS_URL=redis://localhost:6379
