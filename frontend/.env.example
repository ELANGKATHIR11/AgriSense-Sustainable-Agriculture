# AgriSense Frontend Environment
# Copy this file to .env and fill in your values.
# All variables must be prefixed with VITE_ to be available in the browser.
# Never commit the .env file.

# ─── API endpoints ────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
VITE_ML_SERVICE_URL=http://localhost:8000

# ─── App configuration ────────────────────────────────────
VITE_APP_TITLE=AgriSense

# ─── Feature flags ────────────────────────────────────────
# Set to true to enable Edge AI features (requires :5002 service running)
VITE_USE_EDGE_AI=false
